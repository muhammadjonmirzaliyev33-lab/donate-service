PORT=8080

DATABASE_URL=postgres://zaryad:zaryad@localhost:5432/zaryad

# Ikkinchi (backup/mirror) baza — masalan Neon. Berilsa, asosiy DB'ga yozilgan har bir
# so'rov (va tranzaksiya) muvaffaqiyatli bajarilgandan keyin shu bazaga ham yoziladi.
# Bo'sh qoldirilsa — o'chirilgan holda ishlaydi, faqat DATABASE_URL ishlatiladi.
BACKUP_DATABASE_URL=

# BotFather'dan olinadigan token
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Vergul bilan ajratilgan adminlar — raqamli Telegram user id yoki "@username".
# Masalan: ADMIN_TELEGRAM_IDS=123456789,@UZDI_ORG
# Eslatma: username'ni egasi istalgan vaqt o'zgartira oladi, raqamli id esa hech qachon
# o'zgarmaydi — shuning uchun imkon bo'lsa raqamli id yozing.
ADMIN_TELEGRAM_IDS=123456789,987654321

# Admin signal xabarlari (chek, buyurtma + Tasdiqlash/Rad etish tugmalari) yuboriladigan chat.
# Raqamli chat id (shaxsiy chat, guruh yoki kanal) YOKI ommaviy kanal/guruh "@username"i.
# Muhim: Telegram Bot API "@username"ni FAQAT kanal va ommaviy supergruppa uchun qabul qiladi —
# shaxsiy foydalanuvchiga yuborish uchun raqamli id kerak. Bot o'sha kanalda admin bo'lishi shart.
ADMIN_ALERT_CHAT_ID=123456789

# Mini App frontend manzili (CORS uchun)
FRONTEND_ORIGIN=http://localhost:5173

# 'polling' — lokal/dev uchun, ochiq HTTPS domen shart emas (standart).
# 'webhook' — production uchun; PUBLIC_URL berilsa, setWebhook avtomatik chaqiriladi.
TELEGRAM_BOT_MODE=polling

# Faqat TELEGRAM_BOT_MODE=webhook bo'lganda kerak — serveringizning ochiq HTTPS manzili
# (masalan https://api.zaryad.uz). Berilsa, /bot/webhook avtomatik ulanadi.
PUBLIC_URL=

# PayCore supplier API kaliti (https://supplier.pay-core.ru/docs) — o'yin valyutalarini
# avtomatik yetkazib berish uchun. Bo'sh qoldirilsa, integratsiya o'chirilgan holda ishlaydi.
PAYCORE_API_KEY=

# MooGold (https://doc.moogold.com) — ikkinchi yetkazib beruvchi. Har bir o'yin uchun
# qaysi provayder ishlatilishi admin panelda tanlanadi. Bo'sh qoldirilsa — o'chirilgan.
MOOGOLD_PARTNER_ID=
MOOGOLD_SECRET_KEY=

# CoinDrop (https://coindrop.uz/api-docs) — uchinchi yetkazib beruvchi, X-API-Key bilan.
# Bo'sh qoldirilsa — o'chirilgan holda ishlaydi.
COINDROP_API_KEY=

# Telefondagi SMS Forwarder dasturidan POST /webhooks/sms'ga keladigan so'rovlarni
# tekshirish uchun maxfiy kalit. Bo'sh qoldirilsa, bu endpoint doim 401 qaytaradi.
SMS_WEBHOOK_SECRET=

# Broadcast xabar yuborishda ikkita so'rov bir vaqtda ishlab ketmasligi uchun qulf sifatida
# ishlatiladi (masalan redis://localhost:6379). Bo'sh qoldirilsa, qulf ishlamaydi.
REDIS_URL=

# Cloudinary (https://cloudinary.com/console) — o'yin muqovasi, paket rasmi va bosh sahifa
# bannerlarini yuklash uchun. Bo'sh qoldirilsa, rasm yuklash o'chirilgan holda ishlaydi.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
