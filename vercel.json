{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo 'root install skipped, handled in buildCommand'",
  "rewrites": [
    {
      "source": "/users",
      "destination": "https://komak-bot.onrender.com/users"
    },
    {
      "source": "/games",
      "destination": "https://komak-bot.onrender.com/games"
    },
    {
      "source": "/payments",
      "destination": "https://komak-bot.onrender.com/payments"
    },
    {
      "source": "/payment-cards",
      "destination": "https://komak-bot.onrender.com/payment-cards"
    },
    {
      "source": "/settings",
      "destination": "https://komak-bot.onrender.com/settings"
    },
    {
      "source": "/banners",
      "destination": "https://komak-bot.onrender.com/banners"
    },
    {
      "source": "/rating",
      "destination": "https://komak-bot.onrender.com/rating"
    },
    {
      "source": "/promo-codes",
      "destination": "https://komak-bot.onrender.com/promo-codes"
    },
    {
      "source": "/admin",
      "destination": "https://komak-bot.onrender.com/admin"
    },
    {
      "source": "/admin-auth",
      "destination": "https://komak-bot.onrender.com/admin-auth"
    },
    {
      "source": "/health",
      "destination": "https://komak-bot.onrender.com/health"
    },
    {
      "source": "/users/:path*",
      "destination": "https://komak-bot.onrender.com/users/:path*"
    },
    {
      "source": "/games/:path*",
      "destination": "https://komak-bot.onrender.com/games/:path*"
    },
    {
      "source": "/payments/:path*",
      "destination": "https://komak-bot.onrender.com/payments/:path*"
    },
    {
      "source": "/payment-cards/:path*",
      "destination": "https://komak-bot.onrender.com/payment-cards/:path*"
    },
    {
      "source": "/settings/:path*",
      "destination": "https://komak-bot.onrender.com/settings/:path*"
    },
    {
      "source": "/banners/:path*",
      "destination": "https://komak-bot.onrender.com/banners/:path*"
    },
    {
      "source": "/rating/:path*",
      "destination": "https://komak-bot.onrender.com/rating/:path*"
    },
    {
      "source": "/promo-codes/:path*",
      "destination": "https://komak-bot.onrender.com/promo-codes/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://komak-bot.onrender.com/admin/:path*"
    },
    {
      "source": "/admin-auth/:path*",
      "destination": "https://komak-bot.onrender.com/admin-auth/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://komak-bot.onrender.com/health/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
